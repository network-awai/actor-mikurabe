{:paths ["src"]
 ;; kotoba-lang/langgraph brings kotoba-lang/langchain transitively (both
 ;; zero-/single-dep, all .cljc → portable to JVM / SCI / ClojureScript /
 ;; GraalVM).
 ;;
 ;; NOTE on the path below vs. sibling actors' deps.edn: tashikame's and
 ;; yosoku's own deps.edn still say `io.github.com-junkawasaki/langgraph-clj`
 ;; at `../../com-junkawasaki/langgraph-clj` — that checkout is retired
 ;; locally (see `.git/orphan-retire-archive-20260717/
 ;; orgs_com-junkawasaki_langgraph-clj.meta.txt`: "class=successor-leftover
 ;; maps_to=orgs/kotoba-lang/langgraph"). The repo itself was renamed/moved
 ;; to `kotoba-lang/langgraph` (root CLAUDE.md "Repo naming — no -clj
 ;; suffix"); GitHub confirms `com-junkawasaki/langgraph-clj` now redirects
 ;; to `kotoba-lang/langgraph`. mikurabe is a NEW registration, so it points
 ;; at the CURRENT canonical coordinates instead of perpetuating the stale
 ;; path (same for langchain below).
 :deps {
        ;; kotoba.lang.coll replaced clojure.set here (2026-09-24). An explicit
        ;; floor: kotoba.lang.coll carries clojure.set's union/intersection/
        ;; difference/map-invert from 0ffd5f6, and tools.deps takes the NEWEST
        ;; sha it is shown.
        io.github.kotoba-lang/coll {:git/sha "0ffd5f6340af50871d4759b06e02ac4fbf9a4bdf"}
        ;; kotoba.lang.edn replaced clojure.edn here (2026-09-23). An explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, and kbb resolves git deps
        ;; only from nbb.edn, so every project file this repo has names it.
        io.github.kotoba-lang/edn {:git/sha "79dba32c8892058842c57783f06a2dfe4601aeb0"}
       ;; kotoba.lang.text, not clojure.string. Pinned as an explicit floor:
        ;; tools.deps takes the NEWEST sha it is shown, so without a floor here
        ;; this repo silently rides whatever a sibling happens to name.
        io.github.kotoba-lang/text {:git/sha "73bdb13ae7a3d004b44bca08be03a3191157a38f"}
       org.clojure/clojure {:mvn/version "1.12.0"}
        io.github.kotoba-lang/json {:git/sha "4e33e06b4d66b365d27a51393a16a0acd660f9be"} ; aozora publish + LLM json — pinned floor, tools.deps takes newest sha shown
        io.github.kotoba-lang/langgraph
        {:local/root "../../kotoba-lang/langgraph"}}
 :aliases
 {;; offline workspace dev — pin transitive langchain to local checkout
  :dev {:override-deps
        {io.github.kotoba-lang/langchain
         {:local/root "../../kotoba-lang/langchain"}}}
  ;; kbb -M:dev:run → drive representative topic-cluster proposals
  ;; through the actor (mock advisor + mock publisher, no network)
  :run {:main-opts ["-m" "mikurabe.sim"]}
  :test {:extra-paths ["test"]
         :extra-deps {io.github.cognitect-labs/test-runner
                      {:git/tag "v0.5.1" :git/sha "dfb30dd6605cb6c0efc275e1df1736f6e90d4d73"}}
         :main-opts ["-m" "cognitect.test-runner"]}
  :lint {:replace-deps {clj-kondo/clj-kondo {:mvn/version "2024.11.14"}}
         :main-opts    ["-m" "clj-kondo.main" "--lint" "src" "test" "--fail-level" "error"]}}}
